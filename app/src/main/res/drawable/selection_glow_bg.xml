<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Faint Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="1000dp" />
            <solid android:color="#05FFFF00" />
            <padding android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp" />
        </shape>
    </item>
    <!-- Middle Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="1000dp" />
            <solid android:color="#10FFFF00" />
            <padding android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp" />
        </shape>
    </item>
    <!-- Inner Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="1000dp" />
            <solid android:color="#20FFFF00" />
            <padding android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <!-- Core Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="1000dp" />
            <stroke android:width="2dp" android:color="#80FFFF00" />
        </shape>
    </item>
</layer-list>
