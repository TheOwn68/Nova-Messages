<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Black Outline (Base layer) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#000000" />
            <size android:width="26dp" android:height="26dp" />
        </shape>
    </item>
    <!-- The Actual Color Circle (centered with 2dp inset for a thicker border) -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
