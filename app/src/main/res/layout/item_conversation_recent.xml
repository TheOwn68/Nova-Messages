<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/recent_selection_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/selection_glow_bg"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recent_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:padding="12dp"
        android:background="@drawable/pill_background_recent_1">

    <ImageView
        android:id="@+id/recent_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/recent_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@id/recent_body"
        app:layout_constraintEnd_toStartOf="@id/recent_date"
        app:layout_constraintStart_toEndOf="@id/recent_image"
        app:layout_constraintTop_toTopOf="@id/recent_image"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="+1765001009" />

    <TextView
        android:id="@+id/recent_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textColor="#444444"
        app:layout_constraintBottom_toBottomOf="@id/recent_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/recent_image"
        app:layout_constraintTop_toBottomOf="@id/recent_address"
        tools:text="Is this Gary?" />

    <TextView
        android:id="@+id/recent_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginEnd="12dp"
        app:layout_constraintBaseline_toBaselineOf="@id/recent_address"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="6 May" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
