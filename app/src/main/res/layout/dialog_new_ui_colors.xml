<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_ui_colors_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/colors_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colors for New UI"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <RelativeLayout
        android:id="@+id/color_recent_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="?selectableItemBackground">
        <TextView
            android:id="@+id/color_recent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top 2 Contacts"
            android:textSize="16sp" />
        <View
            android:id="@+id/color_recent_preview"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/color_preview_bg" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/color_row1_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="?selectableItemBackground">
        <TextView
            android:id="@+id/color_row1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row 1"
            android:textSize="16sp" />
        <View
            android:id="@+id/color_row1_preview"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/color_preview_bg" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/color_row2_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="?selectableItemBackground">
        <TextView
            android:id="@+id/color_row2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row 2"
            android:textSize="16sp" />
        <View
            android:id="@+id/color_row2_preview"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/color_preview_bg" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/color_row3_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="?selectableItemBackground">
        <TextView
            android:id="@+id/color_row3_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Row 3"
            android:textSize="16sp" />
        <View
            android:id="@+id/color_row3_preview"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/color_preview_bg" />
    </RelativeLayout>

</LinearLayout>
